# GPT Memory Agent - Environment Variables

# OpenAI API Key (required)
OPENAI_API_KEY=sk-proj-KBwxEpp1RpXCO9ULiCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Memory Agent Configuration
MEMORY_AGENT_CONFIG=./config/default_config.yaml

# Model Settings
MEMORY_AGENT_MODEL=gpt-4o
